# Jamf Pro credentials for GET /api/jamf/devices.
# Copy to .env (gitignored) and fill in real values -- never commit secrets.
#
# `main()` loads .env from the project root via the dotenv crate, so `cargo run`
# picks these up automatically -- no exporting needed.
#
# Real environment variables take precedence over .env, so a value exported in
# your shell (or injected by a container or CI) overrides the file.

# Base URL including the /api suffix, no trailing slash.
JAMF_BASE_URL=https://zipziptest.jamfcloud.com/api

# Jamf Pro account with the "Read Computers" privilege.
JAMF_USERNAME=
JAMF_PASSWORD=
