    {
      "id": "TQAT2uYY2Gi8YhWG9DBvt",
      "type": "text",
      "x": 603.1347415413638,
      "y": 342.36014302216535,
      "width": 349.2797546386719,
      "height": 875,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7DV",
      "roundness": null,
      "seed": 781700146,
      "version": 713,
      "versionNonce": 23005613,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1792632862561,
      "created": 1792163743860,
      "link": null,
      "locked": false,
      "text": "1. 200 messages per day per person\n\n8 bn - total \n5 bn - internet\n4 bn - aware about gpt\n\n20-25% weekly ~ 1 bn\n\n30-40% of 1 bn = 300 million\n\npower users 20%  ~ 50 messages\nregular 20% ~ 20 messages\n casual 60% ~ 10 messages\n\n20 messages per day\n\n\n20 words ~ \n\nsys - 100 tokens\nthinking - 40 tokens\noutput - 40 tokens\nchat hist - 400 tokens\n\n~ 600 tokens \n\n\n\n\n\n30 messages per person per day\n\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "beu7AO45ySINpO4Rbe-Wz",
      "originalText": "1. 200 messages per day per person\n\n8 bn - total \n5 bn - internet\n4 bn - aware about gpt\n\n20-25% weekly ~ 1 bn\n\n30-40% of 1 bn = 300 million\n\npower users 20%  ~ 50 messages\nregular 20% ~ 20 messages\n casual 60% ~ 10 messages\n\n20 messages per day\n\n\n20 words ~ \n\nsys - 100 tokens\nthinking - 40 tokens\noutput - 40 tokens\nchat hist - 400 tokens\n\n~ 600 tokens \n\n\n\n\n\n30 messages per person per day\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
