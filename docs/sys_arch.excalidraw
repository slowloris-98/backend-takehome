    {
      "id": "ORMrOUVmUVw_ds7C77Mgb",
      "type": "text",
      "x": 1534.9224057331528,
      "y": 416.14715239164826,
      "width": 685.2196044921875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
