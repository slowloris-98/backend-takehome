      "updated": 1792632862561,
      "created": 1792172437145,
      "link": null,
      "locked": false,
      "text": "Required numbers:\n\n1. no of people in the world (8 bn)\n2. no of people with internet (6 bn)\n3. no of tokens in a single word (100 token = 75 words) (1.33 tokens)\n4. how much load a single gpu can deal with\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "Cot8kdCQy-r6zxDUOa01f",
      "originalText": "Required numbers:\n\n1. no of people in the world (8 bn)\n2. no of people with internet (6 bn)\n3. no of tokens in a single word (100 token = 75 words) (1.33 tokens)\n4. how much load a single gpu can deal with\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
